QPushButton {
    color: #e8eaed;
    background-color: #232d3d;
    border: 1px solid #36435a;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}
QPushButton:hover {
    background-color: #2c3850;
}
QPushButton:pressed {
    background-color: #1b2330;
}
QPushButton:disabled {
    color: #6b7788;
    background-color: #1a212c;
    border-color: #262f3e;
}
QPushButton#generateButton {
    background-color: #2f6f4f;
    border-color: #3d8c63;
    font-weight: bold;
}
QPushButton#generateButton:hover {
    background-color: #3a8760;
}
QPushButton#settingsButton {
    background-color: #1b2330;
    border-color: #2c3648;
}
QPushButton#settingsButton:hover {
    background-color: #263143;
}
QWidget#dropArea {
    background-color: #131a25;
    border: 2px dashed #384358;
    border-radius: 14px;
}
QWidget#dropArea[dropActive="true"] {
    background-color: #17273a;
    border: 2px solid #3d8c63;
}
QListWidget#thumbList {
    background-color: #0b0f16;
    border: 1px solid #232d3d;
    border-radius: 12px;
    padding: 8px;
    outline: none;
}
QListWidget#thumbList::item {
    color: #cfd8e3;
    background-color: #161e2a;
    border: 1px solid #232d3d;
    border-radius: 10px;
    margin: 6px;
    padding: 8px;
}
QListWidget#thumbList::item:hover {
    border: 1px solid #3d8c63;
    background-color: #1b2634;
}
QListWidget#thumbList::item:selected {
    border: 1px solid #3d8c63;
    background-color: #1f3346;
    color: #ffffff;
}
QProgressBar#progressBar {
    background-color: #131a25;
    border: 1px solid #232d3d;
    border-radius: 6px;
    height: 12px;
    text-align: center;
    color: transparent;
}
QProgressBar#progressBar::chunk {
    background-color: #3d8c63;
    border-radius: 5px;
}
QMenu {
    color: #e8eaed;
    background-color: #161e2a;
    border: 1px solid #2c3648;
    padding: 6px;
}
QMenu::item {
    padding: 6px 22px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: #2c3850;
}</string>
